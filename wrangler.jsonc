{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remint",
  "compatibility_date": "2026-11-22",
  // Static assets only: no Worker script, so requests are served without invoking (or billing) a Worker.
  "assets": {
    "directory": "./dist/",
    // Unknown paths fall back to index.html; the app has no client-side routes yet, but deep links stay safe.
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "bridge.coderipper.xyz", "custom_domain": true }]
}
